  "guidance": [
    {
      "q": "I paid my fees but my account still shows a balance.",
      "a": "Payments can take time to post to your account.",
      "steps": [
        "Keep your receipt or proof of payment.",
        "Allow the posting period advised by the university.",
        "If the balance remains, contact the Student Finance Department with your proof of payment and Student ID."
      ]
    },
    {
      "q": "I cannot register because of a financial hold.",
      "a": "A hold usually means an outstanding balance or an unresolved account issue.",
      "steps": [
        "Check your fee statement to see the balance.",
        "Clear the balance or arrange a payment plan.",
        "Submit proof of payment and ask for the hold to be reviewed."
      ]
    },
    {
      "q": "I cannot pay my full fees at once.",
      "a": "You may be able to request a payment plan.",
      "steps": [
        "Review your fee statement.",
        "Complete the Payment Plan Request form.",
        "Submit it to the Student Finance Department before the deadline."
      ]
    },
    {
      "q": "I was charged incorrectly or was overcharged.",
      "a": "You can query the charge or request a refund.",
      "steps": [
        "Gather your fee statement and receipts.",
        "Complete the Fee Adjustment / Query Form or the Refund Request form.",
        "Submit it to Student Finance and keep a copy."
      ]
    },
    {
      "q": "I lost my payment receipt.",
      "a": "You can ask for a copy.",
      "steps": [
        "Note the approximate date and amount of the payment.",
        "Complete the Receipt / Statement Copy Request.",
        "Submit it to the Cashier / Payments Office."
      ]
    }
  ]
}
